    Radius = 60,
    AttackDelay = 0.25,
    Bring = false,
    BringDistance = 8,
    HitboxSize = 12,
    AutoEquip = true,
    ExcludeNPC = true,
    MaxTargets = 10,
}
local Config = getgenv().KillAuraConfig
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Blacklist = {
    "Location", "Npc", "Dialog", "CoinStore", "PetNpc",
    "Forge", "Enchant", "Sell", "SkillPreview", "Magician",
    "OdysseyNPC", "SacredDeath", "DialogCaveNpc", "LobbyLocationPortal",
    "CavePortal", "Portal", "Guide", "BoardInteract", "StoneInteract",
}

local function isBlacklisted(obj)
    if not Config.ExcludeNPC then return false end
    local full = obj:GetFullName()
    for _, b in ipairs(Blacklist) do
        if string.find(full, b) then return true end
    end
    return false
end

local function getCharacter()
    local c = LocalPlayer.Character
    if c and c:FindFirstChildOfClass("Humanoid") and c:FindFirstChildOfClass("Humanoid").Health > 0 then
        return c
    end
    return nil
end

local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function ensureWeapon()
    local char = getCharacter()
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and t.Name == "Weapon" then return t end
    end
    if Config.AutoEquip then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            local tool = bp:FindFirstChild("Weapon")
            if tool then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:EquipTool(tool) end) end
                return tool
            end
        end
    end
    return nil
end

local function findEnemies(myPos)
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Health > 0 then
            local model = v.Parent
            if model and model:IsA("Model") and model ~= LocalPlayer.Character then
                if not Players:GetPlayerFromCharacter(model) then
                    if not isBlacklisted(model) then
                        local eroot = model:FindFirstChild("HumanoidRootPart")
                        if eroot then
                            local dist = (eroot.Position - myPos).Magnitude
                            if dist <= Config.Radius then
                                table.insert(list, { Model = model, Humanoid = v, Root = eroot, Dist = dist })
                                if #list >= Config.MaxTargets then break end
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.Dist < b.Dist end)
    return list
end

local function attackOnce()
    local char = getCharacter()
    if not char then return 0 end
    local myRoot = getHRP(char)
    if not myRoot then return 0 end
    local tool = ensureWeapon()
    local enemies = findEnemies(myRoot.Position)
    if #enemies == 0 then return 0 end
    for _, e in ipairs(enemies) do
        pcall(function()
            if Config.HitboxSize > 0 and e.Root then
                e.Root.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                e.Root.Transparency = 0.7
                e.Root.CanCollide = false
            end
            if Config.Bring and e.Root then
                local targetCF = myRoot.CFrame * CFrame.new(0, 0, -Config.BringDistance)
                pcall(function()
                    e.Root.CFrame = targetCF
                    e.Root.Velocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    end
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local remotes = rs:FindFirstChild("Remotes")
        local act = remotes and remotes:FindFirstChild("PlayerActionRE")
        if act then act:FireServer() end
    end)
    return #enemies
end

getgenv().KillAuraLoopRunning = getgenv().KillAuraLoopRunning or false
getgenv().KillAuraTotalHits = getgenv().KillAuraTotalHits or 0

-- Forward declarations buat UI handles (diisi setelah window jadi)
local ui = {
    statTargets = nil,
    statHits = nil,
    console = nil,
    statusText = nil,
}
local windowRef = nil

local function logLine(s)
    pcall(function()
        if ui.console then ui.console:Append(s) end
    end)
    print("[KillAura] " .. tostring(s))
end

local function startLoop()
    if getgenv().KillAuraLoopRunning then return end
    getgenv().KillAuraLoopRunning = true
    task.spawn(function()
        local tick = 0
        while getgenv().KillAuraLoopRunning do
            if Config.Enabled then
                local ok, n = pcall(attackOnce)
                if ok and n > 0 then
                    getgenv().KillAuraTotalHits = getgenv().KillAuraTotalHits + n
                end
            end
            tick = tick + 1
            -- update Stat tiap ~1 detik (AttackDelay 0.25 -> tiap 4 tick)
            if tick % 4 == 0 then
                pcall(function()
                    local char = getCharacter()
                    local myPos = char and getHRP(char) and getHRP(char).Position or nil
                    local count = 0
                    if myPos then count = #findEnemies(myPos) end
                    if ui.statTargets then ui.statTargets:Set(count) end
                    if ui.statHits then ui.statHits:Set(getgenv().KillAuraTotalHits) end
                    if ui.statusText then
                        if not Config.Enabled then
                            ui.statusText:Set("Idle. Masuk MatchRoom/dungeon biar musuh spawn. NPC toko auto-skip.")
                        elseif count == 0 then
                            ui.statusText:Set("ON - 0 target dalam " .. tostring(Config.Radius) .. " studs. Masuk dungeon / dekatkan musuh.")
                        else
                            ui.statusText:Set("ON - " .. tostring(count) .. " target. Total hits: " .. tostring(getgenv().KillAuraTotalHits))
                        end
                    end
                end)
            end
            task.wait(Config.AttackDelay)
        end
    end)
end

local function stopLoop(restore)
    getgenv().KillAuraLoopRunning = false
    Config.Enabled = false
    if restore == nil then restore = true end
    if restore then
        pcall(function()
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Humanoid") and v.Health > 0 then
                    local m = v.Parent
                    if m and m:FindFirstChild("HumanoidRootPart") then
                        local r = m.HumanoidRootPart
                        if r.Transparency == 0.7 then r.Transparency = 0 end
                    end
                end
            end
        end)
    end
end

getgenv().KillAuraStart = function()
    Config.Enabled = true
    startLoop()
end
getgenv().KillAuraStop = function() stopLoop(true) end

